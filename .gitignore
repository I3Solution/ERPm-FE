## ====================================================================
## ERPm-FE (Angular 18 + Ionic 8 Hybrid) .gitignore
## Repository: https://github.com/I3Solution/ERPm-FE
## ====================================================================

# Compiled output
/dist
dist/
/tmp
tmp/
/out-tsc
/bazel-out

# Node.js
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Angular cache & Sass
.angular/
/.angular/cache
.sass-cache/

# Testing & Coverage
/coverage
coverage/
.nyc_output/
testem.log
/typings

# IDEs and editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Environment configs
.env
.env.*
!.env.example
